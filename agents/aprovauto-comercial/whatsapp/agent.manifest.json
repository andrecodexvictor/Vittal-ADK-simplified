{
  "version": "1.0.0",
  "name": "AprovaAuto Comercial",
  "slug": "aprovauto-comercial",
  "level": "transactional",
  "capabilities": [
    "faq",
    "rag",
    "lead_qualification",
    "crm_update",
    "handoff"
  ],
  "plugins": [
    {
      "id": "builtin.handoff",
      "config": {},
      "requiredEnv": [
        "HANDOFF_ATTENDANTS"
      ]
    },
    {
      "id": "custom.sga",
      "config": {
        "contract": "spec/sga.openapi.json",
        "auth": "bearer",
        "tools": [
          "tool_sga_search_vehicle",
          "tool_sga_simulate_quote",
          "tool_sga_list_products"
        ]
      },
      "requiredEnv": [
        "SGA_BASE_URL",
        "SGA_API_TOKEN"
      ]
    },
    {
      "id": "custom.crm",
      "config": {
        "contract": "spec/crm.openapi.json",
        "auth": "bearer",
        "mock": true
      },
      "requiredEnv": []
    }
  ],
  "publisher": {
    "transport": "rabbitmq",
    "envelope": "uazapi",
    "source": "aprovauto-comercial",
    "requiredEnv": []
  },
  "prompts": {
    "main": "prompts/system.md"
  },
  "knowledge": {
    "path": "knowledge"
  },
  "notes": [
    "Agente COMERCIAL dedicado — cotação/qualificação de leads (config.tools restringe as tools SGA).",
    "Financeiro/sinistro/FAQ geral: direcionar ao número principal (aprovauto-ai).",
    "custom.crm é mock-first (config.mock=true): ao integrar o CRM real (doc do Lucas), declarar CRM_BASE_URL e CRM_BEARER_TOKEN em requiredEnv e tirar CRM_MOCK."
  ]
}
