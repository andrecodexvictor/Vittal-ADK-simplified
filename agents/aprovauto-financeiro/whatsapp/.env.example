# WEBHOOK — deve ser IGUAL ao token da instância UAZAPI do número FINANCEIRO
WEBHOOK_SECRET=

# VITTAL HUB (registrar agente aprovauto-financeiro no Hub e colar a api_key aqui)
HUB_BASE_URL=https://hub.vittalweb.com
HUB_API_KEY=
HUB_AGENT_KEY=

# OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.6
OPENAI_TOP_P=1.0
OPENAI_HISTORY_LIMIT=20

# RABBITMQ
RABBITMQ_URL=amqp://user:pass@host:5672
RABBITMQ_EXCHANGE=vittal.messages
RABBITMQ_ROUTING_KEY=message.direct

# OUTBOUND / UAZAPI (instância do número financeiro)
OUTBOUND_PROVIDER=uazapi
OUTBOUND_SOURCE=aprovauto-financeiro
UAZAPI_URL=https://vittalflow.uazapi.com
UAZAPI_TOKEN=
UAZAPI_BASE_URL=https://vittalflow.uazapi.com

# SGA / APROVAAUTO (mesmas credenciais do agente principal)
SGA_BASE_URL=https://api.hinova.com.br/api/sga/v2
SGA_API_TOKEN=
SGA_USUARIO=
SGA_SENHA=
SGA_MOCK=false
# 60s: a varredura paginada da régua (boleto-associado/periodo) passa de 10s
SGA_TIMEOUT_MS=60000
SGA_CIRCUIT_FAILURE_THRESHOLD=3
SGA_CIRCUIT_WINDOW_MS=60000
SGA_CIRCUIT_OPEN_MS=120000
SGA_MAX_UPLOAD_BYTES=10485760
SGA_BOLETO_OPEN_STATUS_CODE=2

# RÉGUA DE COBRANÇA (billing-runner --agent aprovauto-financeiro)
BILLING_DRY_RUN=true
BILLING_OVERDUE_GRACE_DAYS=2
BILLING_PAGE_SIZE=3000
BILLING_MAX_PAGES=20
BILLING_REMINDER_GROUP=

# FEATURE FLAGS
FEATURE_RESPONDER_GRUPOS=false
FEATURE_FOLLOW_UP=false
FEATURE_ACIONAR_ATENDENTE=true
FEATURE_RAG=true
FEATURE_PROCESSAR_AUDIO=true
FEATURE_PROCESSAR_IMAGEM=false
FEATURE_GROUP_NOTIFICATIONS=false
FEATURE_CAMPANHAS=false

# TRIGGERS & FILTROS
TRIGGER_WORD=
WHITELIST_NUMBERS=
WHITELIST_GROUPS=

# ANTI-SPAM
ANTISPAM_MAX_PER_MIN=10
ANTISPAM_MAX_PER_HOUR=30
ANTISPAM_MUTE_MINUTES=30

# HANDOFF (equipe financeira)
HANDOFF_ATTENDANTS=
HANDOFF_ANNOUNCEMENT_GROUP=
AGENDAMENTO_ANNOUNCEMENT_GROUP=
GROUP_NOTIFICATION_TOKEN=

# APP
AGENT_LEVEL=transactional
AGENT_CAPABILITIES=faq,rag,handoff
DEBOUNCE_MS=3000
PORT=3000
LOG_LEVEL=info
