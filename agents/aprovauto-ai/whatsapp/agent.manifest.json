{
  "version": "1.0.0",
  "name": "AprovaAuto AI",
  "slug": "aprovauto-ai",
  "level": "transactional",
  "capabilities": [
    "faq",
    "rag",
    "lead_qualification",
    "crm_update",
    "handoff"
  ],
  "plugins": [
    {
      "id": "builtin.handoff",
      "config": {},
      "requiredEnv": [
        "HANDOFF_ATTENDANTS"
      ]
    },
    {
      "id": "custom.sga",
      "config": {
        "contract": "spec/sga.openapi.json",
        "auth": "bearer"
      },
      "requiredEnv": [
        "SGA_BASE_URL",
        "SGA_API_TOKEN"
      ]
    }
  ],
  "publisher": {
    "transport": "rabbitmq",
    "envelope": "uazapi",
    "source": "aprovauto-ai",
    "requiredEnv": []
  },
  "prompts": {
    "main": "prompts/system.md"
  },
  "knowledge": {
    "path": "knowledge"
  },
  "notes": [
    "Manifest é a fonte de verdade para level/capabilities/plugins/publisher.",
    "Níveis: informational | transactional | orchestrator",
    "Use transactional para ferramentas que realizam side-effects."
  ]
}
