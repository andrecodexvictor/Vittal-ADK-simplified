# WEBHOOK
WEBHOOK_SECRET=

# VITTAL HUB
HUB_BASE_URL=https://hub.vittalweb.com
HUB_AGENT_KEY=

# OPENAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.6
OPENAI_TOP_P=1.0
OPENAI_HISTORY_LIMIT=20

# RABBITMQ
RABBITMQ_URL=amqp://user:pass@host:5672
RABBITMQ_EXCHANGE=vittal.messages
RABBITMQ_ROUTING_KEY=message.direct

# OUTBOUND / UAZAPI
OUTBOUND_PROVIDER=uazapi
OUTBOUND_SOURCE=aprovauto-ai
UAZAPI_URL=https://flowcrm.uazapi.com
UAZAPI_TOKEN=
UAZAPI_BASE_URL=

# SGA / APROVAAUTO (Hinova v2 — autenticação two-step)
SGA_BASE_URL=https://api.hinova.com.br/api/sga/v2
SGA_API_TOKEN=
SGA_USUARIO=
SGA_SENHA=
SGA_TIMEOUT_MS=10000
SGA_CIRCUIT_FAILURE_THRESHOLD=3
SGA_CIRCUIT_WINDOW_MS=60000
SGA_CIRCUIT_OPEN_MS=120000
SGA_MAX_UPLOAD_BYTES=10485760
# Switch de testes: true intercepta o SGA com mock determinístico (nenhuma chamada real ao ERP)
SGA_MOCK=false
# Códigos operacionais reais (descobertos via scripts/sga-discover.ts — ver spec/SGA-API-PERMISSIONS.md)
SGA_DEFAULT_REGIONAL=1
SGA_DEFAULT_TIPO_VEICULO=1
SGA_CLAIM_STATUS_CODE=3
SGA_CLAIM_TYPE_CODE=6
SGA_SINISTRO_DEPT_CODE=0
SGA_BOLETO_OPEN_STATUS_CODE=2
# Mapa codigo_regional → unidade/equipe (M2). JSON, ex.: {"1":"5577...","2":"5562..."}. Vazio = sem roteamento direcionado.
SGA_REGIONAL_UNIT_MAP=

# FEATURE FLAGS
FEATURE_RESPONDER_GRUPOS=false
FEATURE_FOLLOW_UP=false
FEATURE_ACIONAR_ATENDENTE=true
FEATURE_RAG=true
FEATURE_PROCESSAR_AUDIO=true
FEATURE_PROCESSAR_IMAGEM=true
FEATURE_GROUP_NOTIFICATIONS=false
FEATURE_CAMPANHAS=false

# TRIGGERS & FILTROS
TRIGGER_WORD=
WHITELIST_NUMBERS=
WHITELIST_GROUPS=

# HANDOFF
HANDOFF_ATTENDANTS=
HANDOFF_ANNOUNCEMENT_GROUP=
AGENDAMENTO_ANNOUNCEMENT_GROUP=
GROUP_NOTIFICATION_TOKEN=

# APP
AGENT_LEVEL=transactional
AGENT_CAPABILITIES=faq,rag,lead_qualification,crm_update,handoff
DEBOUNCE_MS=3000
PORT=3000
LOG_LEVEL=info
