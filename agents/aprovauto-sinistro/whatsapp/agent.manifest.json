{
  "version": "1.0.0",
  "name": "AprovaAuto Sinistro",
  "slug": "aprovauto-sinistro",
  "level": "transactional",
  "capabilities": [
    "faq",
    "rag",
    "handoff"
  ],
  "plugins": [
    {
      "id": "builtin.handoff",
      "config": {},
      "requiredEnv": [
        "HANDOFF_ATTENDANTS"
      ]
    },
    {
      "id": "custom.sga",
      "config": {
        "contract": "spec/sga.openapi.json",
        "auth": "bearer",
        "tools": [
          "tool_sga_search_vehicle",
          "tool_sga_create_claim",
          "tool_sga_upload_claim_document",
          "tool_sga_get_claim_status"
        ]
      },
      "requiredEnv": [
        "SGA_BASE_URL",
        "SGA_API_TOKEN"
      ]
    }
  ],
  "publisher": {
    "transport": "rabbitmq",
    "envelope": "uazapi",
    "source": "aprovauto-sinistro",
    "requiredEnv": []
  },
  "prompts": {
    "main": "prompts/system.md"
  },
  "knowledge": {
    "path": "knowledge"
  },
  "notes": [
    "Agente de SINISTRO dedicado — abertura guiada, documentos e status (config.tools restringe as tools SGA).",
    "Cotação/financeiro/FAQ geral: direcionar ao número principal (aprovauto-ai).",
    "FEATURE_PROCESSAR_IMAGEM=true — recebe fotos de CNH/CRLV/avarias para upload no SGA."
  ]
}
